<div class="container" style="padding: 48px 24px; text-align: center;">
  <h1 style="font-family: var(--font-heading); font-size: 28px; margin-bottom: 32px;">Colecciones</h1>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; max-width: 600px; margin: 0 auto;">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'all' -%}
        <a href="{{ collection.url }}" style="text-align: center;">
          {%- if collection.image -%}
            <img src="{{ collection.image | image_url: width: 400 }}" alt="{{ collection.title | escape }}" style="border-radius: 6px; margin-bottom: 12px; border: 1px solid var(--color-border-light);">
          {%- endif -%}
          <h3 style="font-family: var(--font-heading); font-size: 18px; font-weight: 500;">{{ collection.title }}</h3>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>
