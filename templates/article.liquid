<div class="container" style="padding: 48px 24px; max-width: 700px;">
  <h1 style="font-family: var(--font-heading); font-size: 28px; margin-bottom: 8px;">{{ article.title }}</h1>
  <p style="font-size: 12px; color: var(--color-text-light); margin-bottom: 32px;">{{ article.published_at | date: '%d/%m/%Y' }}</p>
  <div style="font-size: 14px; color: var(--color-text-light); line-height: 1.8;">
    {{ article.content }}
  </div>
</div>
