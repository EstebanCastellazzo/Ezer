{%- liquid
  assign anchor_id = section.settings.anchor_id | default: 'testimonios'
-%}

<section class="testimonials fade-in" id="{{ anchor_id }}">
  <div class="testimonials__head">
    {%- if section.settings.eyebrow != blank -%}
      <div class="testimonials__eyebrow">{{ section.settings.eyebrow | escape }}</div>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="testimonials__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="testimonials__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    {%- if section.settings.show_average_rating -%}
      <div class="testimonials__summary">
        {% render 'stars', rating: section.settings.average_rating_stars %}
        <span class="testimonials__summary-text">
          <strong>{{ section.settings.average_rating | escape }}</strong>
          {%- if section.settings.review_count != blank -%}
             · {{ section.settings.review_count | escape }}
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}
  </div>

  <div class="testimonials-grid">
    {%- for block in section.blocks -%}
      {%- assign rating = block.settings.rating | default: 5 -%}
      <figure class="testimonial-card" {{ block.shopify_attributes }}>
        <div class="testimonial-card__header">
          <div class="testimonial-card__avatar">
            {%- if block.settings.photo -%}
              <img
                src="{{ block.settings.photo | image_url: width: 120 }}"
                srcset="{{ block.settings.photo | image_url: width: 80 }} 80w, {{ block.settings.photo | image_url: width: 160 }} 160w"
                sizes="60px"
                alt="{{ block.settings.name | escape }}"
                loading="lazy"
                width="60"
                height="60">
            {%- else -%}
              <span class="testimonial-card__initials" aria-hidden="true">{{ block.settings.initials | default: block.settings.name | slice: 0, 1 | upcase }}</span>
            {%- endif -%}
          </div>
          <div class="testimonial-card__meta">
            <figcaption class="testimonial-card__name">{{ block.settings.name | escape }}</figcaption>
            {%- if block.settings.source != blank -%}
              <div class="testimonial-card__source">{{ block.settings.source | escape }}</div>
            {%- endif -%}
          </div>
        </div>
        {% render 'stars', rating: rating %}
        <blockquote class="testimonial-card__text">{{ block.settings.text | escape }}</blockquote>
      </figure>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonios",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "ID de anclaje (menú)", "default": "testimonios" },
    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "eyebrow", "label": "Pre-título", "default": "TESTIMONIOS" },
    { "type": "text", "id": "title", "label": "Título", "default": "Lo que dicen quienes ya lo probaron" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo (opcional)" },
    { "type": "header", "content": "Resumen de rating (opcional)" },
    { "type": "checkbox", "id": "show_average_rating", "label": "Mostrar rating promedio arriba", "default": true },
    { "type": "range", "id": "average_rating_stars", "label": "Estrellas visibles", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "average_rating", "label": "Rating (ej: 4.9/5)", "default": "4.9/5" },
    { "type": "text", "id": "review_count", "label": "Conteo de reseñas (ej: basado en 127 opiniones)", "default": "basado en +100 opiniones" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Foto (opcional, si no se muestran las iniciales)" },
        { "type": "text", "id": "initials", "label": "Iniciales (si no hay foto)", "default": "" },
        { "type": "text", "id": "name", "label": "Nombre", "default": "María López" },
        { "type": "text", "id": "source", "label": "Fuente (ej: Compra verificada, @usuario)", "default": "Compra verificada" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Testimonio", "default": "La piel de mi bebé nunca estuvo tan suave." }
      ]
    }
  ],
  "presets": [{
    "name": "Testimonios",
    "settings": {
      "eyebrow": "TESTIMONIOS",
      "title": "Lo que dicen quienes ya lo probaron",
      "show_average_rating": true,
      "average_rating": "4.9/5",
      "review_count": "basado en +100 opiniones"
    },
    "blocks": [
      { "type": "testimonial", "settings": { "name": "María López",   "source": "Compra verificada", "rating": 5, "text": "La piel de mi bebé nunca estuvo tan suave. Se nota el cambio desde la primera semana." } },
      { "type": "testimonial", "settings": { "name": "Ana García",    "source": "Compra verificada", "rating": 5, "text": "Por fin una crema que puede usar toda la familia sin dudar. Huele increíble." } },
      { "type": "testimonial", "settings": { "name": "Laura Sánchez", "source": "Compra verificada", "rating": 5, "text": "Ingredientes reales, resultados reales. Mi piel está más firme y luminosa." } }
    ]
  }]
}
{% endschema %}
