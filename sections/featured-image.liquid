<section class="featured-image fade-in">
  {%- if section.settings.image -%}
    <img
      src="{{ section.settings.image | image_url: width: 1200 }}"
      alt="{{ section.settings.image.alt | escape | default: 'EZER' }}"
      loading="lazy"
    >
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag }}
  {%- endif -%}
  <div class="featured-image__overlay">
    <p class="featured-image__text">{{ section.settings.text | default: 'Ingredientes que respetan tu piel' }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Imagen destacada",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "text", "label": "Texto overlay", "default": "Ingredientes que respetan tu piel" }
  ],
  "presets": [{ "name": "Imagen destacada" }]
}
{% endschema %}
