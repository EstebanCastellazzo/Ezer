{%- comment -%}
  Usage: {% render 'stars', rating: 5 %}
  rating: integer 1..5 (default 5)
{%- endcomment -%}
{%- assign r = rating | default: 5 -%}
<div class="stars" aria-label="{{ r }} de 5 estrellas">
  {%- for i in (1..5) -%}
    {%- if i <= r -%}
      {% render 'icon', name: 'star' %}
    {%- else -%}
      <span class="stars__empty" aria-hidden="true">{% render 'icon', name: 'star' %}</span>
    {%- endif -%}
  {%- endfor -%}
</div>
